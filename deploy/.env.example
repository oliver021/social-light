# Copy to .env and replace every CHANGE_ME with a random value (e.g. `openssl rand -hex 16`).
POSTGRES_PASSWORD=CHANGE_ME
EVENTBUS_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

IDENTITY_API_IMAGE=sociallight/identity-api:demo
PROFILE_API_IMAGE=sociallight/profile-api:demo
POSTS_API_IMAGE=sociallight/posts-api:demo
ENGAGEMENT_API_IMAGE=sociallight/engagement-api:demo
SOCIALGRAPH_API_IMAGE=sociallight/socialgraph-api:demo
FEED_API_IMAGE=sociallight/feed-api:demo
MEDIA_SERVICE_IMAGE=sociallight/media-service:demo
GROUPS_API_IMAGE=sociallight/groups-api:demo
EVENTS_API_IMAGE=sociallight/events-api:demo
STORIES_API_IMAGE=sociallight/stories-api:demo
REELS_API_IMAGE=sociallight/reels-api:demo
NOTIFICATIONS_API_IMAGE=sociallight/notifications-api:demo
CHAT_API_IMAGE=sociallight/chat-api:demo
CATALOG_API_IMAGE=sociallight/catalog-api:demo
WEB_IMAGE=sociallight/web:demo

IDENTITY_API_PORT=8080

# Published on the LXC; put Caddy / Nginx Proxy Manager in front for HTTPS.

# Optional overrides (defaults shown)
# PUBLIC_WEB_PORT=3000
# PUBLIC_GATEWAY_PORT=8088
