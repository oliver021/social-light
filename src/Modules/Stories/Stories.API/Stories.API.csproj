<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Stories.API — the module's service: domain + application + infrastructure +
    HTTP endpoints in a single canonical project (DESIGN-STRATEGY.md §1: ceremony
    proportional to complexity). It owns the "stories" schema and its DbContext;
    cross-module data flows only through Stories.Contracts events.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stories.Contracts\Stories.Contracts.csproj" />
    <ProjectReference Include="..\..\..\EventBusRabbitMQ\EventBusRabbitMQ.csproj" />
    <ProjectReference Include="..\..\..\SocialLight.ServiceDefaults\SocialLight.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Stories.FunctionalTests" />
  </ItemGroup>

</Project>
