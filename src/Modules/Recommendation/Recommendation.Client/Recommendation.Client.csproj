<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Recommendation.Client — the typed HTTP client (DESIGN-STRATEGY.md §5). The ONE
    artifact shared across every frontend (web, MAUI native, hand-built feed). It
    references only Recommendation.Contracts, so a frontend consumes it without any
    backend dependency — port-based decoupling across the client/server boundary.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Recommendation.Contracts\Recommendation.Contracts.csproj" />
  </ItemGroup>

</Project>
