    <ProjectReference Include="..\Modules\Notifications\Notifications.API\Notifications.API.csproj" />
    <ProjectReference Include="..\Modules\Gaming\Gaming.API\Gaming.API.csproj" />
    <ProjectReference Include="..\Modules\Jobs\Jobs.API\Jobs.API.csproj" />
    <ProjectReference Include="..\Modules\Moderation\Moderation.API\Moderation.API.csproj" />
    <ProjectReference Include="..\Modules\Pages\Pages.API\Pages.API.csproj" />
    <ProjectReference Include="..\Modules\Recommendation\Recommendation.API\Recommendation.API.csproj" />
    <ProjectReference Include="..\Modules\Threads\Threads.API\Threads.API.csproj" />
