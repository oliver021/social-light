{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  },
  "OpenApi": {
    "Endpoint": {
      "Name": "Basket.API V1"
    },
    "Document": {
      "Description": "The Basket Microservice HTTP API (REST adapter over the gRPC cart).",
      "Title": "SocialLight - Basket HTTP API",
      "Version": "v1"
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost",
    "EventBus": "amqp://localhost"
  },
  "Identity": {
    "Audience": "socialapi",
    "Scopes": {
      "socialapi": "socialLight API"
    }
  },
  "EventBus": {
    "SubscriptionClientName": "Basket"
  }
}
