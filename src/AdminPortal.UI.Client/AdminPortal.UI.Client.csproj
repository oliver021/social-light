<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    AdminPortal.UI.Client — the WASM half: the admin UI that runs in the browser.
    Generated by the code-engine "aggregate" (fan-in) scope: one typed-client
    ProjectReference per module spec below, plus a generated grid page per entity and
    a nav that converges all 16 modules. Add a spec to src/app-specs
    and re-run `generate-portal` to wire a new module into the portal.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SocialLight.AdminPortal.UI.Client</RootNamespace>
    <NoWarn>$(NoWarn);RZ10021</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <!-- The aggregator (client half): one typed-client reference per module spec. -->
  <ItemGroup>
    <ProjectReference Include="..\Modules\Chat\Chat.Client\Chat.Client.csproj" />
    <ProjectReference Include="..\Modules\Engagement\Engagement.Client\Engagement.Client.csproj" />
    <ProjectReference Include="..\Modules\Events\Events.Client\Events.Client.csproj" />
    <ProjectReference Include="..\Modules\Gaming\Gaming.Client\Gaming.Client.csproj" />
    <ProjectReference Include="..\Modules\Groups\Groups.Client\Groups.Client.csproj" />
    <ProjectReference Include="..\Modules\Jobs\Jobs.Client\Jobs.Client.csproj" />
    <ProjectReference Include="..\Modules\Moderation\Moderation.Client\Moderation.Client.csproj" />
    <ProjectReference Include="..\Modules\Notifications\Notifications.Client\Notifications.Client.csproj" />
    <ProjectReference Include="..\Modules\Organizations\Organizations.Client\Organizations.Client.csproj" />
    <ProjectReference Include="..\Modules\Pages\Pages.Client\Pages.Client.csproj" />
    <ProjectReference Include="..\Modules\Posts\Posts.Client\Posts.Client.csproj" />
    <ProjectReference Include="..\Modules\Recommendation\Recommendation.Client\Recommendation.Client.csproj" />
    <ProjectReference Include="..\Modules\Reels\Reels.Client\Reels.Client.csproj" />
    <ProjectReference Include="..\Modules\SocialGraph\SocialGraph.Client\SocialGraph.Client.csproj" />
    <ProjectReference Include="..\Modules\Stories\Stories.Client\Stories.Client.csproj" />
    <ProjectReference Include="..\Modules\Threads\Threads.Client\Threads.Client.csproj" />
  </ItemGroup>

</Project>
