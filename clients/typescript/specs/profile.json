{
  "openapi": "3.1.1",
  "info": {
    "title": "Profile API",
    "description": "Hand-written social profile service (Phase 2).",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://localhost:57721/"
    }
  ],
  "paths": {
    "/api/profiles": {
      "get": {
        "tags": [
          "Profiles"
        ],
        "summary": "List profiles to discover (excludes the caller)",
        "operationId": "ListProfiles",
        "parameters": [
          {
            "name": "api-version",
            "in": "query",
            "description": "The API version, in the format 'major.minor'.",
            "schema": {
              "type": "string",
              "example": "1.0"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProfileDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          { }
        ]
      }
    },
    "/api/profiles/me": {
      "get": {
        "tags": [
          "Profiles"
        ],
        "summary": "Get the authenticated user's profile",
        "operationId": "GetMyProfile",
        "parameters": [
          {
            "name": "api-version",
            "in": "query",
            "description": "The API version, in the format 'major.minor'.",
            "schema": {
              "type": "string",
              "example": "1.0"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          { }
        ]
      },
      "put": {
        "tags": [
          "Profiles"
        ],
        "summary": "Create or update the authenticated user's profile",
        "operationId": "EditMyProfile",
        "parameters": [
          {
            "name": "api-version",
            "in": "query",
            "description": "The API version, in the format 'major.minor'.",
            "schema": {
              "type": "string",
              "example": "1.0"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          { }
        ]
      }
    },
    "/api/profiles/{userId}": {
      "get": {
        "tags": [
          "Profiles"
        ],
        "summary": "Get a user's profile by id",
        "operationId": "GetProfile",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "api-version",
            "in": "query",
            "description": "The API version, in the format 'major.minor'.",
            "schema": {
              "type": "string",
              "example": "1.0"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          { }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ProfileDto": {
        "required": [
          "userId",
          "displayName",
          "handle",
          "bio",
          "avatarUrl",
          "location",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "handle": {
            "type": [
              "null",
              "string"
            ]
          },
          "bio": {
            "type": [
              "null",
              "string"
            ]
          },
          "avatarUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "location": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpdateProfileRequest": {
        "required": [
          "displayName",
          "bio",
          "avatarUrl",
          "location",
          "handle"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "bio": {
            "type": [
              "null",
              "string"
            ]
          },
          "avatarUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "location": {
            "type": [
              "null",
              "string"
            ]
          },
          "handle": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "implicit": {
            "authorizationUrl": "http://localhost:57683/connect/authorize",
            "tokenUrl": "http://localhost:57683/connect/token",
            "scopes": {
              "socialapi": "socialLight API"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Profiles"
    }
  ]
}