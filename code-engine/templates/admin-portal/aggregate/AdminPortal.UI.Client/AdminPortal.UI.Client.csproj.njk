<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    AdminPortal.UI.Client — the WASM half: the admin UI that runs in the browser.
    Generated by the code-engine "aggregate" (fan-in) scope: one typed-client
    ProjectReference per module spec below, plus a generated grid page per entity and
    a nav that converges all {{ modules.length }} modules. Add a spec to src/app-specs
    and re-run `generate-portal` to wire a new module into the portal.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SocialLight.AdminPortal.UI.Client</RootNamespace>
    <NoWarn>$(NoWarn);RZ10021</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <!-- The aggregator (client half): one typed-client reference per module spec. -->
  <ItemGroup>
{% for m in modules %}
    <ProjectReference Include="..\Modules\{{ m.module }}\{{ m.module }}.Client\{{ m.module }}.Client.csproj" />
{% endfor %}
  </ItemGroup>

</Project>
