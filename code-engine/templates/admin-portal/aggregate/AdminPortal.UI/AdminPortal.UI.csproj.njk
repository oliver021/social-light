<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    AdminPortal.UI — the HOST half of the hosted-WASM admin portal (host-as-BFF):
    it serves the AdminPortal.UI.Client WASM, reverse-proxies /api/* to the module
    services via Aspire service discovery, hosts the realtime SignalR hub, and
    subscribes to the broker. Generated by the code-engine "aggregate" (fan-in)
    scope — the per-module proxy routes and event subscriptions below come from ALL
    {{ modules.length }} module specs.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SocialLight.AdminPortal.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery.Yarp" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SocialLight.ServiceDefaults\SocialLight.ServiceDefaults.csproj" />
    <ProjectReference Include="..\EventBusRabbitMQ\EventBusRabbitMQ.csproj" />
    <!-- Hosts the WASM client (serves its static framework files). -->
    <ProjectReference Include="..\AdminPortal.UI.Client\AdminPortal.UI.Client.csproj" />
  </ItemGroup>

</Project>
