@* Generated (entity scope, category-1 immutable): a CRUD grid for {{ module }}.{{ Entity }},
   one per entity across every module. A list page IS a direct projection of the spec
   (DESIGN-STRATEGY.md §6), so it is generated, never hand-edited. It consumes the typed
   {{ module }}Client exactly as a hand-built page would — the seam rides on the contract. *@
@page "/admin/{{ moduleKebab }}/{{ entityPluralKebab }}"
@inject {{ module }}Client Client
@inject ISnackbar Snackbar

<PageTitle>Admin · {{ EntityPlural }}</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">{{ EntityPlural }}</MudText>
    <MudChip T="string" Size="Size.Small" Color="Color.Default">{{ module }}</MudChip>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_loading">Refresh</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="CreateSampleAsync" Disabled="_loading">New sample</MudButton>
</MudStack>

<MudDataGrid T="{{ Entity }}Dto" Items="_items" Loading="_loading" Dense="true" Hover="true"
             Filterable="true" SortMode="SortMode.Multiple" QuickFilter="_quickFilter">
    <ToolBarContent>
        <MudTextField @bind-Value="_search" Placeholder="Search" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium"
                      Immediate="true" Class="mt-0" />
    </ToolBarContent>
    <Columns>
{% for f in fields %}
        <PropertyColumn Property="x => x.{{ f.Name }}" Title="{{ f.Name }}" />
{% endfor %}
    </Columns>
    <NoRecordsContent>
        <MudText Class="pa-4" Color="Color.Secondary">No {{ entityPlural }} yet.</MudText>
    </NoRecordsContent>
</MudDataGrid>

@code {
    private IReadOnlyList<{{ Entity }}Dto> _items = [];
    private bool _loading;
    private string _search = string.Empty;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = await Client.Get{{ EntityPlural }}Async();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load {{ entityPlural }}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateSampleAsync()
    {
        _loading = true;
        try
        {
            // Deterministic sample built from the spec (the same data the generated
            // functional tests use) — no inference. Replace with a real form (category-3).
            await Client.Create{{ Entity }}Async(new Create{{ Entity }}Request({% for f in createFields %}{{ f.csSample }}{% if not loop.last %}, {% endif %}{% endfor %}));
            Snackbar.Add("Created a sample {{ Entity }}.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Create failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private Func<{{ Entity }}Dto, bool> _quickFilter => x =>
        string.IsNullOrWhiteSpace(_search) || x.ToString()!.Contains(_search, StringComparison.OrdinalIgnoreCase);
}
