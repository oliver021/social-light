        var client = CreateClient();
        var create = await client.PostAsJsonAsync(BasePath, {{ sampleExpr }}, TestContext.Current.CancellationToken);
        var created = await create.Content.ReadFromJsonAsync<{{ Entity }}Dto>(_json, TestContext.Current.CancellationToken);
        Assert.NotNull(created);

        var delete = await client.DeleteAsync($"{BasePath}/{created!.{{ keyField.Name }}}", TestContext.Current.CancellationToken);
