<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    {{ module }}.API — the module's service: domain + application + infrastructure +
    HTTP endpoints in a single canonical project (DESIGN-STRATEGY.md §1: ceremony
    proportional to complexity). It owns the "{{ schema }}" schema and its DbContext;
    cross-module data flows only through {{ module }}.Contracts events.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\{{ module }}.Contracts\{{ module }}.Contracts.csproj" />
    <ProjectReference Include="{{ srcRef }}\EventBusRabbitMQ\EventBusRabbitMQ.csproj" />
    <ProjectReference Include="{{ srcRef }}\SocialLight.ServiceDefaults\SocialLight.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="{{ module }}.FunctionalTests" />
  </ItemGroup>

</Project>
