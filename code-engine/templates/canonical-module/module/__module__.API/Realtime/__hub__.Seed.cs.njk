using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.SignalR;

namespace {{ namespace }}.Realtime;

/// <summary>
/// {{ realtime.hub }} — the realtime layer over the generated CRUD
/// (DESIGN-STRATEGY.md §6, category-3 "manual on generated rails"). This is the
/// genuinely novel part the engine lays down ONCE as a seed, then you own:
/// inference is reserved for behavior like this, never the boilerplate around it.
///
/// It reuses the generated <c>{{ realtime.messageEntity.Entity }}Service</c> port
/// for persistence and fans messages out to per-conversation connection groups.
/// The sender is bound from the JWT principal — never the client payload — exactly
/// like the owner-binding rule on the REST endpoints.
/// </summary>
[Authorize]
public class {{ realtime.hub }}(IServiceScopeFactory scopeFactory) : Hub
{
    private static string Group(Guid {{ realtime.groupField.camel }}) => $"{{ realtime.groupPrefix }}-{ {{ realtime.groupField.camel }} }";

    /// <summary>Subscribe this connection to a conversation's live updates.</summary>
    public Task Join(Guid {{ realtime.groupField.camel }}) =>
        Groups.AddToGroupAsync(Context.ConnectionId, Group({{ realtime.groupField.camel }}));

    /// <summary>Unsubscribe this connection from a conversation.</summary>
    public Task Leave(Guid {{ realtime.groupField.camel }}) =>
        Groups.RemoveFromGroupAsync(Context.ConnectionId, Group({{ realtime.groupField.camel }}));

    /// <summary>
    /// Persist a message through the module's service, then broadcast it to everyone
    /// in the conversation group as "Receive{{ realtime.messageEntity.Entity }}".
    /// </summary>
    public async Task Send({% for f in realtime.sendParams %}{{ f.csType }}{% if f.nullable %}?{% endif %} {{ f.camel }}{% if not loop.last %}, {% endif %}{% endfor %})
    {
        var senderId = Guid.Parse(Context.User?.GetUserId()
            ?? throw new HubException("Missing 'sub' claim"));

        // SignalR hubs are transient; resolve the scoped service in its own scope.
        await using var scope = scopeFactory.CreateAsyncScope();
        var service = scope.ServiceProvider.GetRequiredService<{{ realtime.messageEntity.Entity }}Service>();
        var message = await service.CreateAsync({{ realtime.createArgs | join(', ') }}, Context.ConnectionAborted);

        var dto = new {{ realtime.messageEntity.Entity }}Dto({{ realtime.dtoArgs | join(', ') }});
        await Clients.Group(Group({{ realtime.groupField.camel }})).SendAsync("Receive{{ realtime.messageEntity.Entity }}", dto, Context.ConnectionAborted);
    }
}
