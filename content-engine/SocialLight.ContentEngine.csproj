<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>content-engine</AssemblyName>
    <RootNamespace>SocialLight.ContentEngine</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    The content-engine is the synthetic-content host (dev-only). It has no
    package references: inference talks to a local llama.cpp OpenAI-compatible
    server over HttpClient, and the seed contract is plain System.Text.Json.
    Per-module push bindings + typed clients are slated to come from code-engine
    (see content-engine/README.md), not hand-written sprawl.
  -->

</Project>
